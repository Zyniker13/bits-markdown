{
  "name": "bristlecone/bits-markdown",
  "description": "Markdown for WordPress without Jetpack, with iA Writer-aligned syntax.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://bristleconeit.com/bits-markdown",
  "support": {
    "issues": "https://github.com/Zyniker13/bits-markdown/issues",
    "source": "https://github.com/Zyniker13/bits-markdown"
  },
  "require": {
    "php": ">=8.1",
    "league/commonmark": "^2.7",
    "scrivo/highlight.php": "^9.18",
    "symfony/yaml": "^6.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Bristlecone\\BitsMarkdown\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bristlecone\\BitsMarkdown\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": "phpunit",
    "release": "@php bin/build-release.php"
  }
}
